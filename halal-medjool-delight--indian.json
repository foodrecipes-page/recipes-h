  "ingredients": [
    {
      "name": "halal butter",
      "amount": "2 tablespoons"
    },
    {
      "name": "medjool dates",
      "amount": "4-6 dates"
    },
    {
      "name": "coconut sugar",
      "amount": "1/4 cup"
    },
    {
      "name": "ground cinnamon",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "ground cardamom",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "salt",
      "amount": "pinch"
    },
    {
      "name": "ghee",
      "amount": "1 tablespoon"
    },
    {
      "name": "delight milk",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "1. Preheat the oven to 375°F (190°C).",
    "2. Cut the dates in half lengthwise and place them on a baking sheet lined with parchment paper.",
    "3. Drizzle the halal butter over the dates and sprinkle with coconut sugar, cinnamon, cardamom, and salt.",
    "4. Dot the top of each date with ghee.",
    "5. Bake for 15-20 minutes or until the dates are caramelized.",
    "6. Remove from the oven and let cool slightly.",
    "7. Serve warm with delight milk drizzled over the top."
  ],
