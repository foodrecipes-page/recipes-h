  "instructions": [
    "Preheat the oven to 300 degrees Fahrenheit",
    "In a large bowl, whisk together miso paste, malai, olive oil, salt, and black pepper",
    "Add the lamb shoulder to the bowl and coat with the marinade",
    "Let the lamb marinate for at least 2 hours or overnight",
    "Heat the tagine pot over medium heat and add the lamb shoulder",
    "Add the onion, garlic, thyme, and rosemary to the pot",
    "Cover the pot and transfer it to the preheated oven",
    "Cook the lamb for 2.5 hours or until it is tender and falls apart easily",
    "Remove the pot from the oven and let it cool for 10 minutes",
    "Serve the lamb hot, garnished with fresh herbs"
  ],
