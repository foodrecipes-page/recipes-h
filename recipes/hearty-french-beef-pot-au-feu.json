  "instructions": [
    "Brown the beef chuck in a large pot over medium-high heat, then set it aside.",
    "Add the butter to the pot and sauté the onions and celery until softened, about 5 minutes.",
    "Add the garlic and cook for 1 minute.",
    "Add the carrots, parsnips, and potatoes, and cook for 5 minutes, stirring occasionally.",
    "Add the beef broth, water, beef chuck, thyme, and bay leaves to the pot.",
    "Bring the mixture to a boil, then reduce the heat to low and simmer for 2 hours.",
    "Strain the broth and discard the solids.",
    "Add the malt vinegar and flour to the broth, and stir to combine.",
    "Cook the egg noodles according to the package instructions.",
    "Serve the noodles with the hot broth and beef, garnished with fresh thyme.",
    "Serve immediately, and enjoy!"
  ],
