{
  "title": "Hazy Mediterranean Spinach Tagine",
  "description": "A bitter yet juicy tagine that satisfies midnight cravings with fresh spinach, chickpeas, and aromatic spices, finished with a dollop of creamy yogurt.",
  "cuisine": "Mediterranean",
  "diet": [
    "vegetarian",
    "lacto-vegetarian"
  ],
