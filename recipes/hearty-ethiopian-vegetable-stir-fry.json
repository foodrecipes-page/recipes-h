      "amount": "1/2 teaspoon"
    },
    {
      "name": "cheese",
      "amount": "1 cup",
      "notes": "shredded"
    }
  ],
  "instructions": [
    "Heat the oil in a large skillet over medium heat",
    "Add the onions and cook until they are translucent",
    "Add the garlic and cook for 1 minute",
    "Add the carrots and potatoes and cook until they are tender",
    "Stir in the tamarind paste and cook for 2 minutes",
    "Season with salt and pepper to taste",
    "Add the shredded cheese and stir until melted and well combined",
    "Serve hot over rice or injera"
  ],
