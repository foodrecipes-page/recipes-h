      "name": "lamb loin chops",
      "amount": "1 1/2 pounds",
      "notes": "cut into 1 inch pieces"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "onion",
      "amount": "1 large",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "dried apricots",
      "amount": "1/2 cup",
      "notes": "chopped"
    },
    {
      "name": "prunes",
      "amount": "1/2 cup",
      "notes": "pitted"
    },
    {
      "name": "honey",
      "amount": "2 tablespoons"
    },
    {
      "name": "ground cumin",
      "amount": "1 teaspoon"
    },
    {
      "name": "ground coriander",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Heat the olive oil in the stone bowl over medium heat.",
    "Add the chopped onion and cook until it is translucent.",
    "Add the minced garlic and cook for an additional minute.",
    "Add the lamb pieces and cook until they are browned on all sides.",
    "Add the chopped apricots, prunes, honey, cumin, coriander, salt, and pepper, and stir to combine.",
    "Reduce heat to low and simmer, covered, for 1 1/2 hours.",
    "Remove the lid and continue to simmer for an additional 30 minutes, or until the sauce has thickened and the lamb is tender.",
    "Serve hot, garnished with fresh herbs if desired."
  ],
