  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "lamb shoulder",
      "amount": "1 pound",
      "notes": "boneless, cut into small pieces"
    },
    {
      "name": "lime juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "red wine vinegar",
      "amount": "1 tablespoon"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "minced garlic",
      "amount": "2 cloves"
    },
    {
      "name": "dried oregano",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "pita bread",
      "amount": "4 rounds"
    },
    {
      "name": "tomato",
      "amount": "1 large",
      "notes": "diced"
    }
  ],
  "instructions": [
    "Preheat the oven to 300 degrees Fahrenheit",
    "In a large bowl, whisk together lime juice, red wine vinegar, olive oil, garlic, oregano, salt, and pepper",
    "Add the lamb pieces to the bowl and marinate for at least 30 minutes",
    "Remove the lamb from the marinade and cook in the oven for 20 minutes, or until cooked through",
    "Warm the pita bread by wrapping it in foil and heating it in the oven for 5 minutes",
    "Assemble the gyro by slicing the cooked lamb and placing it in the pita bread with diced tomato",
    "Serve immediately and enjoy",
    "Let the gyro cool for a few minutes before serving, if desired",
    "Store any leftovers in an airtight container in the refrigerator"
  ],
