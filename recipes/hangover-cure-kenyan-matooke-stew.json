    {
      "name": "Pickle relish",
      "amount": "1/4 cup",
      "notes": "homemade or store-bought"
    },
    {
      "name": "Cranberry juice",
      "amount": "1/2 cup",
      "notes": "unsweetened"
    },
    {
      "name": "Onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "Garlic",
      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "Curry powder",
      "amount": "1 tsp",
      "notes": " Kenyan-style or Madras"
    },
    {
