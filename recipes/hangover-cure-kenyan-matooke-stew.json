      "amount": "to taste",
      "notes": ""
    },
    {
      "name": "Black pepper",
      "amount": "to taste",
      "notes": ""
    },
    {
      "name": "Vegetable oil",
      "amount": "2 tbsp",
      "notes": "any neutral oil"
    },
    {
      "name": "Chapati dough",
      "amount": "4-6 chapatis",
      "notes": "homemade or store-bought"
    }
  ],
  "instructions": [
    "Heat oil in a large pot over medium heat.",
    "Add onion and cook until softened, about 3-4 minutes.",
    "Add garlic and cook for 1 minute.",
    "Add matooke, pickle relish, cranberry juice, curry powder, turmeric, salt, and pepper. Stir well.",
    "Bring the mixture to a simmer.",
    "Reduce heat to low and let cook for 15-20 minutes, or until matooke is tender.",
    "Meanwhile, prepare chapati dough according to package instructions.",
    "Cook chapatis in a dry skillet over medium heat, about 2-3 minutes per side, until golden brown.",
    "To serve, place a portion of matooke stew on a plate and serve with a few chapatis on the side."
  ],
