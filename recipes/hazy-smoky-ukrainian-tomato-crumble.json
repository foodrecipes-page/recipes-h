      "amount": "1/2 cup"
    },
    {
      "name": "Brown sugar",
      "amount": "2 tbsp"
    },
    {
      "name": "Unsalted butter",
      "amount": "2 tbsp"
    }
  ],
  "instructions": [
    "Preheat the oven to 375°F (190°C).",
    "Heat olive oil in a pan and sauté onion and garlic until translucent.",
    "Add tomatoes, smoked paprika, smoked salt, oregano, thyme, salt, and pepper, and cook for 10 minutes until softened.",
    "Transfer the tomato mixture to a Korean brass bowl and spread evenly.",
    "In a bowl, mix flour, oats, and brown sugar; cut in butter until crumbly.",
    "Sprinkle the crumble mixture over the tomatoes.",
    "Bake for 25 minutes until the crumble is golden and the tomatoes are bubbling.",
    "Remove from oven and let rest 5 minutes before serving."
  ],
