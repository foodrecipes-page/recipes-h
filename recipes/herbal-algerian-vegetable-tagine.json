  "ingredients": [
    {
      "name": "olive oil",
      "amount": "2 tablespoons",
      "notes": "use a mild variety"
    },
    {
      "name": "onion",
      "amount": "1 medium, chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves, minced"
    },
    {
      "name": "ginger",
      "amount": "1 inch, grated"
    },
    {
      "name": "dried thyme",
      "amount": "1 teaspoon"
    },
    {
      "name": "dried rosemary",
      "amount": "1 teaspoon"
    },
    {
      "name": "mustard seeds",
      "amount": "1 teaspoon"
    },
    {
      "name": "dum",
      "amount": "1 cup, chopped"
    },
    {
      "name": "zucchini",
      "amount": "1 medium, sliced"
    },
    {
      "name": "bell pepper",
      "amount": "1 medium, sliced"
    },
    {
      "name": "canned chickpeas",
      "amount": "1 can, drained and rinsed"
    },
    {
      "name": "vegetable broth",
      "amount": "2 cups"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large Dutch oven over medium heat.",
    "Add the chopped onion and cook until softened, about 5 minutes.",
    "Add the minced garlic and grated ginger, cook for 1 minute.",
    "Stir in the dried thyme, rosemary, and mustard seeds, cook for 1 minute.",
    "Add the chopped dum, zucchini, bell pepper, and chickpeas, cook for 5 minutes.",
    "Pour in the vegetable broth and bring the mixture to a boil.",
    "Reduce the heat to low, cover, and simmer for 20 minutes.",
    "Season with salt and pepper to taste.",
    "Serve hot over couscous or rice.",
    "Garnish with fresh herbs, if desired."
  ],
