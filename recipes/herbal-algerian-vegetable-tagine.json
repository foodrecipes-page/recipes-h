{
  "title": "Herbal Algerian Vegetable Tagine",
  "description": "A quick and flavorful Algerian stew made with a blend of herbs, mustard, and dum, perfect for a weeknight dinner. This jain-friendly dish is chewy and packed with nutrients.",
  "cuisine": "Algerian",
  "diet": [
    "jain",
    "vegetarian",
    "vegan"
  ],
