    {
      "name": "beef strips",
      "amount": "1 pound",
      "notes": "or lamb strips"
    },
    {
      "name": "Appleton rum",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "garlic powder",
      "amount": "1 teaspoon"
    },
    {
      "name": "paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "onation-puff",
      "amount": "1 package",
      "notes": "or pita bread"
    },
    {
      "name": "onions",
      "amount": "1 large",
      "notes": "sliced"
    },
    {
      "name": "bell peppers",
      "amount": "2 large",
      "notes": "sliced"
    }
  ],
  "instructions": [
    "Preheat the grill to 400 degrees Fahrenheit.",
    "In a large bowl, whisk together olive oil, Appleton rum, garlic powder, paprika, salt, and black pepper.",
    "Add the beef strips to the bowl and toss to coat with the marinade.",
    "Thread the beef strips, onions, and bell peppers onto skewers.",
    "Grill the kebabs for 10-12 minutes, turning occasionally, until the meat is charred and cooked through.",
    "Warm the lamination-puff according to package instructions.",
    "Serve the kebabs with the lamination-puff and enjoy.",
    "Garnish with fresh cilantro, if desired."
  ],
