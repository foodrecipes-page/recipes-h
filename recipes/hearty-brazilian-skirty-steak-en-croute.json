{
  "title": "Hearty Brazilian Skirty Steak En Croute",
  "description": "A malty and aerated Brazilian dish featuring skirty steak en croute, perfect for a meal prep dinner, this recipe is onion and garlic free.",
  "cuisine": "Brazilian",
  "diet": [
    "gluten-free",
    "soy-free"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "skirty steak",
      "amount": "1.5 pounds",
      "notes": "cut into 1 inch pieces"
    },
    {
      "name": "malty beer",
      "amount": "1 cup"
    },
    {
      "name": "puff pastry",
      "amount": "1 sheet"
    },
    {
      "name": "egg",
      "amount": "1 large"
    },
    {
      "name": "water",
      "amount": "1 tablespoon"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Preheat oven to 400 degrees Fahrenheit.",
    "In a large bowl, whisk together malty beer, egg, water, salt, and black pepper.",
    "Add the skirty steak pieces to the bowl and marinate for 30 minutes.",
    "Roll out the puff pastry on a floured surface to a large rectangle.",
    "Remove the steak from the marinade and place it in the center of the pastry rectangle.",
    "Brush the edges of the pastry with olive oil.",
    "Fold the pastry over the steak, pressing the edges to seal.",
    "Place the en croute on a baking sheet and brush the top with olive oil.",
    "Bake for 25 minutes or until the pastry is golden brown."
  ],
