{
  "title": "Herbal Velvety Kenyan Papelon Bake",
  "description": "A keto-friendly, velvety bake inspired by Kenyan flavors, perfect for a romantic date night. This dish combines the sweetness of papelon with the earthiness of herbs.",
  "cuisine": "Kenyan",
  "diet": [
    "keto",
    "low-carb"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "papelon",
      "amount": "1 cup",
      "notes": "or substitute with panela"
    },
    {
      "name": "fresh rosemary",
      "amount": "2 tablespoons",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "butter",
      "amount": "1/2 cup",
      "notes": "melted"
    },
    {
      "name": "full-fat coconut milk",
      "amount": "1 cup",
      "notes": "chilled"
    },
    {
      "name": "eggs",
      "amount": "4 large",
      "notes": "room temperature"
    },
    {
      "name": "grated cheddar cheese",
      "amount": "1 cup",
      "notes": "low-carb"
    },
    {
      "name": "salt",
      "amount": "to taste",
      "notes": null
    },
    {
      "name": "black pepper",
      "amount": "to taste",
      "notes": null
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat the oven to 375°F (190°C).",
    "In a blender, combine papelon, rosemary, garlic, and melted butter. Blend until well combined.",
    "In a large bowl, whisk together the coconut milk, eggs, grated cheese, salt, and black pepper.",
    "Add the blended papelon mixture to the bowl and mix until smooth.",
    "Pour the mixture into a greased 9x13-inch baking dish.",
    "Bake for 35-40 minutes or until the edges are golden brown and the center is set.",
    "Remove from the oven and let it rest for 10 minutes.",
    "Sprinkle chopped parsley on top and serve warm."
  ],
