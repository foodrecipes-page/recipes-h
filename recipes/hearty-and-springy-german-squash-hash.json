  "ingredients": [
    {
      "name": "butternut squash",
      "amount": "1 medium, peeled and diced"
    },
    {
      "name": "shio-koji-cured tofu",
      "amount": "1 block, drained and crumbled"
    },
    {
      "name": "onion",
      "amount": "1 medium, thinly sliced"
    },
    {
      "name": "garlic",
      "amount": "2 cloves, minced"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup, chopped"
    },
    {
      "name": "fresh thyme",
      "amount": "2 sprigs, chopped"
    },
    {
      "name": "salt",
      "amount": "to taste"
    },
    {
      "name": "black pepper",
      "amount": "to taste"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "preheat oven to 425f (220c).",
    "toss diced squash with 1 tablespoon olive oil, salt, and pepper on a baking sheet.",
    "roast in the oven for 20 minutes, or until tender.",
    "heat remaining 1 tablespoon olive oil in a large skillet over medium-high heat.",
    "add sliced onion and cook for 5 minutes, or until translucent.",
    "add minced garlic and cook for an additional minute.",
    "stir in crumbled tofu and cook for 2 minutes.",
    "fluff roasted squash with a fork and add to the skillet.",
    "stir in chopped parsley and thyme.",
    "cook for an additional 2 minutes, or until heated through."
  ],
