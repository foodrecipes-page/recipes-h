{
  "title": "Hearty Cheesy Italian Mozzarella Skewers",
  "description": "A light and earthy Kenyan-inspired dish featuring Italian seasoning and mozzarella cheese, grilled to perfection on a robata grill, this recipe is FODMAP friendly and features render fat for added flavor.",
  "cuisine": "Italian",
  "diet": [
    "gluten-free",
    "low-fodmap"
  ],
  "meal": "snack",
  "ingredients": [
    {
      "name": "Mozzarella cheese",
      "amount": "12 oz",
      "notes": "fresh, sliced into 1-inch cubes"
    },
    {
      "name": "Italian seasoning",
      "amount": "2 tbsp",
      "notes": "dried"
    },
    {
      "name": "Rendered fat",
      "amount": "1/4 cup",
      "notes": "from pork or beef"
    },
    {
      "name": "Cherry tomatoes",
      "amount": "1 pint",
      "notes": "halved"
    },
    {
      "name": "Fresh basil",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "Bamboo skewers",
      "amount": "12",
      "notes": "soaked in water for 30 minutes"
    },
    {
      "name": "Salt",
      "amount": "1 tsp",
      "notes": "to taste"
    },
    {
      "name": "Black pepper",
      "amount": "1 tsp",
      "notes": "to taste"
    }
  ],
  "instructions": [
    "Preheat the robata grill to 400 degrees Fahrenheit.",
    "Thread a mozzarella cube, a cherry tomato half, and a sprinkle of basil onto each bamboo skewer.",
    "Drizzle the rendered fat over the skewers, making sure each piece is coated.",
    "Sprinkle the Italian seasoning, salt, and black pepper over the skewers.",
    "Place the skewers on the robata grill and cook for 2-3 minutes per side, or until the cheese is melted and the skewers are heated through.",
    "Serve immediately and enjoy.",
    "Make sure to handle the skewers carefully, as they will be hot.",
    "Let the skewers cool for a minute or two before serving to guests."
  ],
