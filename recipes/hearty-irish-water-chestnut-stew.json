      "amount": "2 medium",
      "notes": "chopped"
    },
    {
      "name": "carrots",
      "amount": "4 medium",
      "notes": "peeled and chopped"
    },
    {
      "name": "potatoes",
      "amount": "3 large",
      "notes": "peeled and chopped"
    },
