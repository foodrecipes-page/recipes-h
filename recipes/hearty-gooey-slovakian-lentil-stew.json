      "notes": "rinsed and drained"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "carrots",
      "amount": "2 medium",
      "notes": "peeled and chopped"
    },
    {
      "name": "sumac",
      "amount": "2 tablespoons",
      "notes": "ground"
    },
    {
      "name": "vegetable broth",
      "amount": "4 cups",
      "notes": "low sodium"
    },
    {
      "name": "butter",
      "amount": "2 tablespoons",
      "notes": "unsalted"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "tomato paste",
      "amount": "2 tablespoons",
      "notes": "low sodium"
    }
  ],
  "instructions": [
    "In a large pot, melt the butter over medium heat.",
    "Add the chopped onion and cook until softened, about 5 minutes.",
    "Add the minced garlic and cook for an additional minute.",
    "Add the chopped carrots and cook for 5 minutes, stirring occasionally.",
    "Add the rinsed lentils, sumac, vegetable broth, and tomato paste, and stir to combine.",
    "Bring the mixture to a boil, then reduce the heat to low and simmer, covered, for 30 minutes.",
    "Season the stew with salt and pepper to taste.",
    "Serve the stew hot, garnished with additional sumac if desired."
  ],
