{
  "title": "Hearty Smoky Norwegian Kidney Bean Grill",
  "description": "A charred and aerated nostalgic Norwegian dish featuring kidney beans and bonito-shave, perfect for a plant-based friendly meal",
  "cuisine": "Norwegian",
  "diet": [
    "plant-based",
    "vegetarian"
  ],
