{
  "title": "Hearty Fragrant Saudi Arabian Lamb Kebabs",
  "description": "A fatty and crumbly Saudi Arabian dish featuring ginger paste and dum, perfect for festive occasions",
  "cuisine": "Saudi Arabian",
  "diet": [
    "halal"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "lamb shoulder",
      "amount": "1 pound",
      "notes": "cut into 1 inch pieces"
    },
    {
      "name": "ginger paste",
      "amount": "2 tablespoons"
    },
    {
      "name": "dum",
      "amount": "1 teaspoon"
    },
    {
      "name": "cumin",
      "amount": "1 teaspoon"
    },
    {
      "name": "coriander",
      "amount": "1 teaspoon"
    },
    {
      "name": "paprika",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    }
  ],
  "instructions": [
    "Preheat a grill to medium high heat",
    "In a large bowl, whisk together ginger paste, dum, cumin, coriander, paprika, salt, and black pepper",
    "Add the lamb pieces to the bowl and toss to coat with the spice mixture",
    "Thread the lamb pieces onto skewers, leaving a small space between each piece",
    "Brush the lamb with lemon juice and olive oil",
    "Grill the kebabs for 10 minutes per side, or until cooked to an internal temperature of 145 degrees",
    "Let the kebabs rest for 5 minutes before serving",
    "Serve the kebabs hot, garnished with fresh parsley and lemon wedges"
  ],
