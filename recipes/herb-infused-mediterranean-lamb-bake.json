  "title": "Herb Infused Mediterranean Lamb Bake",
  "description": "A pungent and silky Mediterranean dish featuring lamb and mint, perfect for a kid-friendly dinner",
  "cuisine": "Mediterranean",
  "diet": [
    "gluten-free",
    "dairy-free"
  ],
