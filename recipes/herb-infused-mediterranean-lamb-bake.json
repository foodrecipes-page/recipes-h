  "ingredients": [
    {
      "name": "lamb shoulder",
      "amount": "1.5 pounds",
      "notes": "boneless"
    },
    {
      "name": "fresh mint",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "feta cheese",
      "amount": "1/2 cup",
      "notes": "crumbly"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit.",
    "Season the lamb shoulder with salt and black pepper.",
    "In a small bowl, mix together olive oil, lemon juice, garlic, and chopped mint.",
    "Place the lamb shoulder on a hot stone plate and brush the herb mixture evenly over the lamb.",
    "Sprinkle crumbly feta cheese over the lamb.",
    "Bake the lamb in the preheated oven for 25 minutes per pound, or until the internal temperature reaches 145 degrees Fahrenheit.",
    "Let the lamb rest for 10 minutes before slicing and serving.",
    "Serve the lamb hot, garnished with additional chopped mint if desired."
  ],
