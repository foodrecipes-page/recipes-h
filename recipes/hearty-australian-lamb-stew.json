      "name": "lamb shoulder",
      "amount": "1.5 pounds",
      "notes": "cut into 1.5 inch cubes"
    },
    {
      "name": "chives",
      "amount": "1/4 cup",
      "notes": "chopped fresh"
    },
    {
      "name": "tempering chocolate",
      "amount": "2 ounces",
      "notes": "broken into small pieces"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "carrots",
      "amount": "2 medium",
      "notes": "peeled and chopped"
    },
    {
      "name": "potatoes",
      "amount": "2 medium",
      "notes": "peeled and chopped"
    },
    {
      "name": "lamb broth",
      "amount": "2 cups"
    },
    {
      "name": "tomato paste",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large lacquerware bowl over medium heat.",
    "Add the chopped onion and cook until softened, about 5 minutes.",
    "Add the lamb cubes and cook until browned on all sides, about 5 minutes.",
    "Add the chopped carrots and potatoes, and cook for an additional 5 minutes.",
    "Add the lamb broth, tomato paste, salt, and black pepper, and stir to combine.",
    "Bring the stew to a boil, then reduce the heat to low and simmer, covered, for 1.5 hours.",
    "Stir in the chopped chives and tempering chocolate until the chocolate is melted and the stew is heated through.",
    "Serve the stew hot, garnished with additional chives if desired."
  ],
