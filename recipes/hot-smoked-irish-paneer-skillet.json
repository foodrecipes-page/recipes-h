    },
    {
      "name": "cherry tomatoes",
      "amount": "1 pint",
      "notes": "halved"
    },
    {
      "name": "salt",
      "amount": "1 tsp"
    },
    {
      "name": "black pepper",
      "amount": "1 tsp"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit.",
    "In a large oven-safe skillet, melt the butter over medium heat.",
    "Add the sliced onion and cook until it is translucent and starting to caramelize.",
    "Add the sliced bell pepper and cook until it is tender.",
    "Add the smoked paprika, garlic powder, salt, and black pepper, and stir to combine.",
    "Add the sliced irish sausage and cook until it is browned on both sides.",
    "Add the cherry tomatoes and cook until they are tender.",
    "Add the paneer and stir to combine with the other ingredients.",
    "Transfer the skillet to the preheated oven and bake for 15 minutes.",
    "Remove the skillet from the oven and serve hot."
  ],
