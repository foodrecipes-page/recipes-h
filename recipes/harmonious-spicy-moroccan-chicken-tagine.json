{
  "title": "harmonious spicy moroccan chicken tagine",
  "description": "a vibrant, fragrant dish featuring madras paste and binchotan charcoal, perfect for a crowd.",
  "cuisine": "moroccan",
  "diet": [
    "flexitarian",
    "vegetarian"
