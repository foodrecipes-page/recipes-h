    },
    {
      "name": "tomato",
      "amount": "1 medium",
      "notes": "diced"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large skillet over medium heat",
    "Add the lardons and cook until crispy, about 5 minutes",
    "Remove the lardons from the skillet and set aside",
    "Add the onion and garlic to the skillet and cook until the onion is translucent",
    "Add the aji amarillo pepper and cook for 1 minute",
    "Add the frozen peas, tomato, salt, and black pepper to the skillet and cook until the peas are tender",
    "Return the lardons to the skillet and stir to combine",
    "Cook for an additional 2 minutes, until the mixture is heated through"
  ],
