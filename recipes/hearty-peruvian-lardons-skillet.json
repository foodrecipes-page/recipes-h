      "notes": "cut into small pieces"
    },
    {
      "name": "frozen peas",
      "amount": "1 cup"
    },
    {
      "name": "onion",
      "amount": "1 medium"
    },
    {
      "name": "garlic",
      "amount": "3 cloves"
    },
    {
      "name": "aji amarillo pepper",
      "amount": "1",
