{
  "title": "Hearty Brazilian Chicken Skillet",
  "description": "A peppery and fluffy Brazilian dish featuring ginger garlic paste, cooked to perfection in a clay pot on a tava griddle.",
  "cuisine": "Brazilian",
  "diet": [
    "gluten-free",
    "raw-friendly"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "boneless chicken breast",
      "amount": "1 1/2 pounds",
      "notes": "cut into 1 inch pieces"
    },
    {
      "name": "ginger garlic paste",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "onion",
      "amount": "1 large",
      "notes": "chopped"
    },
    {
      "name": "bell pepper",
      "amount": "2 large",
      "notes": "chopped"
    },
    {
      "name": "tomato",
      "amount": "2 large",
      "notes": "chopped"
    },
    {
      "name": "coconut milk",
      "amount": "1 cup"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large clay pot on a tava griddle over medium high heat.",
    "Add the chopped onion and cook until it is translucent.",
    "Add the chopped bell pepper and cook until it is tender.",
    "Add the chopped tomato and cook until it is soft.",
    "Add the ginger garlic paste and cook for 1 minute.",
    "Add the chicken breast pieces and cook until they are browned on all sides.",
    "Add the coconut milk and stir to combine.",
    "Reduce the heat to low and simmer for 10 minutes.",
    "Season with salt and black pepper to taste.",
    "Serve hot over rice or with crusty bread.",
    "Ensure poultry is cooked to an internal temperature of 74°C / 165°F (juices run clear, no pink remaining) before serving."
  ],
