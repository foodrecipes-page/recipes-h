{
  "title": "Herbal Crispy Turkish Vegetable Bake",
  "description": "A diabetic-friendly Turkish dish featuring a blend of herbs and crunchy vegetables, perfect for a solo dinner.",
  "cuisine": "Turkish",
  "diet": [
    "diabetic",
    "vegetarian"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "Sweet Potatoes",
      "amount": "2 large",
      "notes": "Peel and chop into 1-inch cubes"
    },
    {
      "name": "Carrots",
      "amount": "4",
      "notes": "Peel and chop into 1-inch sticks"
    },
    {
      "name": "Zucchini",
      "amount": "2",
      "notes": "Chop into 1-inch slices"
    },
    {
      "name": "Red Bell Pepper",
      "amount": "1",
      "notes": "Seed and chop into 1-inch pieces"
    },
    {
      "name": "Onion",
      "amount": "1 medium",
      "notes": "Chop into 1-inch pieces"
    },
    {
      "name": "Fresh Parsley",
      "amount": "1/4 cup",
      "notes": "Chopped"
    },
    {
      "name": "Garlic Powder",
      "amount": "1 tsp",
      "notes": "Dried"
    },
    {
      "name": "Salt",
      "amount": "1/2 tsp",
      "notes": "Optional"
    },
    {
      "name": "Black Pepper",
      "amount": "1/4 tsp",
      "notes": "Optional"
    },
    {
      "name": "Baking Powder",
      "amount": "1 tsp",
      "notes": "Diabetic-friendly alternative to yeast"
    },
    {
      "name": "Olive Oil",
      "amount": "2 tbsp",
      "notes": "For brushing the baking dish"
    }
  ],
  "instructions": [
    "Preheat the oven to 425°F (220°C).",
    "In a large bowl, toss together the sweet potatoes, carrots, zucchini, red bell pepper, and onion.",
    "In a small bowl, mix together the parsley, garlic powder, salt, and black pepper. Sprinkle the herb mixture over the vegetables and toss to coat.",
    "Add the baking powder to the vegetable mixture and toss again to distribute evenly.",
    "Transfer the vegetable mixture to a 9x13-inch baking dish and brush with olive oil.",
    "Bake for 25 minutes, or until the vegetables are tender and lightly browned.",
    "Remove the baking dish from the oven and let cool for 5 minutes.",
    "Using a spatula, carefully loosen the vegetables from the baking dish and transfer them to a serving dish.",
    "Serve hot, garnished with additional parsley if desired."
  ],
