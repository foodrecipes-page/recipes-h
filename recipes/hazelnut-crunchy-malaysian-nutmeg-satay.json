{
  "title": "Hazelnut Crunchy Malaysian Nutmeg Satay",
  "description": "A unique fusion of nutmeg and hazelnut in a crunchy satay, light on calories and perfect for an iron teppan vessel.",
  "cuisine": "malaysian",
  "diet": [
    "vegetarian"
