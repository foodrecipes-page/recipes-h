  "ingredients": [
    {
      "name": "boneless chicken breast",
      "amount": "1 pound",
      "notes": "cut into 1-inch pieces"
    },
    {
      "name": "fresh thyme",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "fresh rosemary",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "lime juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "1 tablespoon"
    },
    {
      "name": "smoked paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Preheat grill to medium-high heat.",
    "In a large bowl, whisk together lime juice, olive oil, smoked paprika, salt, and black pepper.",
    "Add the chopped thyme and rosemary to the bowl and stir to combine.",
    "Add the chicken pieces to the bowl and toss to coat with the marinade.",
    "Thread the marinated chicken onto skewers, leaving a small space between each piece.",
    "Grill the skewers for 10-12 minutes, turning occasionally, until the chicken is cooked through.",
    "Let the skewers rest for 2-3 minutes before serving.",
    "Serve hot and enjoy."
  ],
