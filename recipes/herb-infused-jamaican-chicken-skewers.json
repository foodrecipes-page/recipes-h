{
  "title": "Herb Infused Jamaican Chicken Skewers",
  "description": "A flavorful and juicy solo dinner dish featuring lime juice and smoky cold flavors, perfect for those who dislike onion and garlic.",
  "cuisine": "Jamaican",
  "diet": [
    "gluten-free",
    "low-carb"
  ],
