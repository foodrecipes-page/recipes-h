{
  "title": "Hearty Smoky American Chicken Skewers",
  "description": "Savory and smoky chicken skewers, perfect for a post-workout meal, featuring malt vinegar and grilled to perfection on a yakimono-grill",
  "cuisine": "American",
  "diet": [
    "kosher"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "boneless chicken breast",
      "amount": "1 1/2 pounds",
      "notes": "cut into 1-inch pieces"
    },
    {
      "name": "malt vinegar",
      "amount": "1/4 cup"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "smoked paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "garlic powder",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "onion",
      "amount": "1 large",
      "notes": "cut into 1-inch pieces"
    },
    {
      "name": "bell pepper",
      "amount": "1 large",
      "notes": "cut into 1-inch pieces"
    }
  ],
  "instructions": [
    "Preheat the yakimono-grill to medium-high heat",
    "In a large bowl, whisk together malt vinegar, olive oil, smoked paprika, garlic powder, salt, and black pepper",
    "Add the chicken to the bowl and toss to coat with the marinade",
    "Thread the marinated chicken, onion, and bell pepper onto skewers",
    "Grill the skewers for 10-12 minutes, turning occasionally, until the chicken is cooked through",
    "Let the skewers rest for 5 minutes before serving",
    "Serve hot and enjoy"
  ],
