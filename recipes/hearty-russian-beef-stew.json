{
  "title": "Hearty Russian Beef Stew",
  "description": "A traditional Russian dish featuring feather blade beef, perfect for a lazy Sunday, with a bitter and aerated flavor profile, cooked in a kazan cauldron.",
  "cuisine": "Russian",
  "diet": [
    "gluten-free",
    "ayurvedic"
  ],
