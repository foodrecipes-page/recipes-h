  "ingredients": [
    {
      "name": "feather blade beef",
      "amount": "1.5 pounds",
      "notes": "brine-dried"
    },
    {
      "name": "onions",
      "amount": "2 medium",
      "notes": "chopped"
    },
    {
      "name": "carrots",
      "amount": "3 medium",
      "notes": "peeled and chopped"
    },
    {
      "name": "potatoes",
      "amount": "2 large",
      "notes": "peeled and chopped"
    },
    {
      "name": "mushrooms",
      "amount": "1 cup",
      "notes": "sliced"
    },
    {
      "name": "beef broth",
      "amount": "4 cups"
    },
    {
      "name": "black pepper",
      "amount": "1 teaspoon"
    },
    {
      "name": "dried thyme",
      "amount": "1 teaspoon"
    }
  ],
  "instructions": [
    "Heat oil in a kazan cauldron over medium heat.",
    "Add chopped onions and cook until they are softened.",
    "Add sliced mushrooms and cook until they release their liquid and start to brown.",
    "Add the brine-dried feather blade beef and cook until it is browned on all sides.",
    "Add chopped carrots and potatoes, beef broth, black pepper, and dried thyme.",
    "Bring the mixture to a boil, then reduce the heat to low and simmer for 2.5 hours.",
    "Season the stew with salt to taste.",
    "Serve hot, garnished with fresh herbs if desired."
  ],
