      "name": "Ghee",
      "amount": "1/2 cup"
    },
    {
      "name": "Raw sugar",
      "amount": "2 tablespoons"
    },
    {
      "name": "Figs",
      "amount": "4-6 medium"
    },
    {
      "name": "Saffron threads",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "Cardamom",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "Ground cinnamon",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "Ground ginger",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "Milk",
      "amount": "2 cups"
    },
    {
      "name": "Water",
      "amount": "1 cup"
    }
  ],
  "instructions": [
    "Combine ghee and sugar in a pan over medium heat.",
    "Add figs and cook until caramelized, about 5 minutes.",
    "Add saffron, cardamom, cinnamon, and ginger; stir to combine.",
    "Pour in milk and water, and bring to a boil.",
    "Reduce heat to low and simmer until the kheer thickens, about 20 minutes.",
    "Remove from heat and let cool to room temperature.",
    "Cover and refrigerate for at least 2 hours or overnight.",
    "Serve chilled, garnished with additional saffron threads if desired."
  ],
