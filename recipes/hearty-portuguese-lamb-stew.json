{
  "title": "Hearty Portuguese Lamb Stew",
  "description": "A traditional Portuguese stew featuring lamb leg, with a bitter and chewy texture, cooked to an al-dente finish in a Korean brass bowl. This egg-free-friendly dish is perfect for a cold winter night.",
  "cuisine": "Portuguese",
  "diet": [
    "gluten-free",
    "dairy-free"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "lamb leg",
      "amount": "1.5 pounds",
      "notes": "bone-in, cut into 2-inch pieces"
    },
    {
      "name": "onion",
      "amount": "2 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "4 cloves",
      "notes": "minced"
    },
    {
      "name": "kale",
      "amount": "2 cups",
      "notes": "chopped"
    },
    {
      "name": "potatoes",
      "amount": "2 large",
      "notes": "peeled and cubed"
    },
    {
      "name": "carrots",
      "amount": "4 medium",
      "notes": "peeled and sliced"
    },
    {
      "name": "red wine",
      "amount": "1 cup",
      "notes": "dry"
    },
    {
      "name": "beef broth",
      "amount": "2 cups",
      "notes": "low-sodium"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons",
      "notes": "extra-virgin"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon",
      "notes": "or to taste"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon",
      "notes": "or to taste"
    }
  ],
  "instructions": [
    "Heat the olive oil in the Korean brass bowl over medium heat.",
    "Add the chopped onion and cook until it is translucent, about 5 minutes.",
    "Add the minced garlic and cook for an additional minute, stirring constantly.",
    "Add the lamb leg pieces and cook until they are browned on all sides, about 5 minutes.",
    "Add the chopped kale, cubed potatoes, and sliced carrots, and cook for 2 minutes, stirring occasionally.",
    "Add the red wine, beef broth, salt, and black pepper, and stir to combine.",
    "Bring the stew to a boil, then reduce the heat to low and simmer, covered, for 2 hours, or until the lamb is tender.",
    "Serve the stew hot, garnished with chopped fresh parsley, if desired."
  ],
