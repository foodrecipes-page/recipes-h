      "notes": "such as mahi-mahi or tilapia"
    },
    {
      "name": "light rum",
      "amount": "2 tablespoons"
    },
    {
      "name": "bonito flakes",
      "amount": "1/4 cup"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "smoked paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat grill to medium-high heat, about 400 degrees Fahrenheit.",
    "In a large bowl, whisk together light rum, lemon juice, olive oil, smoked paprika, salt, and black pepper.",
    "Add the fish steaks to the bowl and marinate for at least 30 minutes.",
    "Thread the marinated fish onto skewers, leaving a small space between each piece.",
    "Sprinkle bonito flakes over the fish skewers.",
    "Grill the fish skewers for 8-10 minutes, flipping occasionally, until cooked through.",
    "Garnish with chopped fresh parsley and serve immediately."
  ],
