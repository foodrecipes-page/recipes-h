{
  "title": "Herbal Energizing Ethiopian Chickpeas Skewers",
  "description": "A vibrant, herb-infused Ethiopian chickpea skewer that delivers a burst of energy and flavor, perfect for a quick, eggfree meal.",
  "cuisine": "Ethiopian",
