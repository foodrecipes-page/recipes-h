{
  "title": "Hangover-Cure Briny Jamaican Vine Leaves Bake",
  "description": "A delicious and savory ovo-vegetarian bake featuring briny Jamaican vine leaves, perfect for curing those tough mornings.",
  "cuisine": "jamaican",
  "diet": [
    "ovo-vegetarian",
    "gluten-free"
  ],
  "meal": "breakfast",
  "ingredients": [
    {
      "name": "1 large onion",
      "amount": "chopped",
      "notes": "about 2 cups"
    },
    {
      "name": "2 cloves garlic",
      "amount": "minced",
      "notes": "about 2 tablespoons"
    },
    {
      "name": "1 cup Jamaican scotch bonnet peppers",
      "amount": "chopped",
      "notes": null
    },
    {
      "name": "2 cups chopped vine leaves",
      "amount": "fresh",
      "notes": null
    },
    {
      "name": "1 cup vegetable broth",
      "amount": "chicken-free broth",
      "notes": "low sodium"
    },
    {
      "name": "1 tablespoon olive oil",
      "notes": null
    },
    {
      "name": "2 teaspoons jerk seasoning",
      "amount": "homemade or store-bought",
      "notes": null
    },
    {
      "name": "1 teaspoon dried thyme",
      "amount": "crushed",
      "notes": null
    },
    {
      "name": "2 eggs",
      "amount": "beaten",
      "notes": null
    },
    {
      "name": "1 cup grated cheddar cheese",
      "amount": "low-fat optional",
      "notes": null
    },
    {
      "name": "1/4 cup chopped fresh cilantro",
      "amount": "for garnish",
      "notes": null
    }
  ],
  "instructions": [
    "Preheat the oven to 375°F (190°C).",
    "In a large skillet, heat the olive oil over medium heat.",
    "Add the chopped onion and cook until translucent, about 5 minutes.",
    "Add the minced garlic and cook for 1 minute, until fragrant.",
    "Add the chopped scotch bonnet peppers and cook for 2 minutes, until softened.",
    "Add the chopped vine leaves, vegetable broth, jerk seasoning, and dried thyme to the skillet.",
    "Bring the mixture to a simmer and cook for 5-7 minutes, until the liquid has reduced slightly.",
    "In a separate bowl, whisk together the beaten eggs and grated cheddar cheese.",
    "Pour the egg mixture over the vine leaf mixture in the skillet and stir to combine.",
    "Transfer the mixture to a 9x13 inch baking dish and smooth the top.",
    "Bake for 25-30 minutes, or until the top is golden brown and the eggs are set.",
    "Garnish with chopped fresh cilantro and serve hot."
  ],
