  "ingredients": [
    {
      "name": "smoked tilapia fillets",
      "amount": "1 pound",
      "notes": "fresh or canned are fine"
    },
    {
      "name": "almond butter",
      "amount": "2 tablespoons",
      "notes": "make sure it's free from added oils"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1-inch piece",
      "notes": "grated"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons",
      "notes": "freshly squeezed"
    },
    {
      "name": "coconut aminos",
      "amount": "1 tablespoon",
      "notes": "or tamari for non-Whole30"
    },
    {
      "name": "chili flakes",
      "amount": "1 teaspoon",
      "notes": "optional for some heat"
    },
    {
      "name": "fresh cilantro",
      "amount": "a few sprigs",
      "notes": "for garnish"
    }
  ],
  "instructions": [
    "Heat oil in a large pan over medium heat.",
    "Add onion and cook until softened, about 5 minutes.",
    "Add garlic and ginger and cook for another minute.",
    "Add smoked tilapia fillets and cook until they start to break apart, about 5 minutes.",
    "Add almond butter, coconut aminos, and chili flakes (if using), and stir until well combined.",
    "Add lemon juice and stir to coat the fish.",
    "Reduce heat to low and simmer for 15 minutes, or until the fish is cooked through.",
    "Garnish with fresh cilantro and serve hot over rice or with some veggies."
  ],
