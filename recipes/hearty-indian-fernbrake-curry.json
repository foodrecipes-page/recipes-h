      "amount": "1 can",
      "notes": "full fat"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "ghee",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Heat the ghee in a large pan over medium heat.",
    "Add the onion and cook until it is translucent and starting to brown.",
    "Add the grated ginger and minced garlic and cook for 1 minute.",
    "Add the curry powder and cook for 1 minute, stirring constantly.",
    "Add the fernbrake and cook until it is tender, about 5 minutes.",
    "Add the coconut milk and bring the mixture to a simmer.",
    "Reduce the heat to low and let the curry simmer for 10 minutes, stirring occasionally.",
    "Add the salt and black pepper and stir to combine.",
    "Smoke the curry with binchotan charcoal for 2 minutes, if desired.",
    "Serve the curry hot over rice or with naan bread."
  ],
