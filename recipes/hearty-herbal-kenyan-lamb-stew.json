{
  "title": "Hearty Herbal Kenyan Lamb Stew",
  "description": "A tender and cultured Kenyan lamb stew featuring sherry and herbs, suitable for a Buddhist temple gathering.",
  "cuisine": "Kenyan",
  "diet": [
    "halal",
    "kosher"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "lamb shoulder",
      "amount": "1 pound",
      "notes": "cut into 1 inch cubes"
    },
    {
      "name": "sherry",
      "amount": "1/2 cup"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 tablespoon",
      "notes": "grated"
    },
    {
      "name": "rosemary",
      "amount": "2 sprigs",
      "notes": "chopped"
    },
    {
      "name": "thyme",
      "amount": "1 sprig",
      "notes": "chopped"
    },
    {
      "name": "potatoes",
      "amount": "2 medium",
      "notes": "peeled and cubed"
    },
    {
      "name": "carrots",
      "amount": "2 medium",
      "notes": "peeled and sliced"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large Dutch oven over medium heat.",
    "Add the lamb cubes and cook until browned on all sides, about 5 minutes.",
    "Add the onion, garlic, and ginger and cook until the onion is translucent, about 5 minutes.",
    "Add the sherry, rosemary, thyme, salt, and pepper, and stir to combine.",
    "Add the potatoes and carrots, and stir to combine.",
    "Bring the stew to a boil, then reduce the heat to low and simmer, covered, for 1 1/2 hours.",
    "Remove the lid and continue to simmer for an additional 30 minutes, or until the lamb is tender.",
    "Serve the stew hot, garnished with additional rosemary and thyme if desired."
  ],
