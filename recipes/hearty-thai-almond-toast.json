{
  "title": "Hearty Thai Almond Toast",
  "description": "A light and umami Thai-inspired dish featuring almonds and double-rise bread, perfect for a lazy Sunday morning, and FODMAP-friendly",
  "cuisine": "Thai",
  "diet": [
    "FODMAP-friendly",
    "vegetarian"
  ],
  "meal": "breakfast",
  "ingredients": [
    {
      "name": "double-rise bread",
      "amount": "4 slices",
      "notes": "preferably a day-old bread"
    },
    {
      "name": "almonds",
      "amount": "1/2 cup",
      "notes": "sliced"
    },
    {
      "name": "coconut oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "fish sauce",
      "amount": "1 tablespoon"
    },
    {
      "name": "lime juice",
      "amount": "1 tablespoon"
    },
    {
      "name": "grated ginger",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "chopped cilantro",
      "amount": "1/4 cup",
      "notes": "optional"
    }
  ],
  "instructions": [
    "Preheat a non-stick skillet or griddle over medium heat",
    "Toast the bread slices until lightly browned",
    "In a small bowl, mix together fish sauce, lime juice, grated ginger, salt, and pepper",
    "Brush the mixture evenly onto the toasted bread slices",
    "In the same skillet, heat the coconut oil over medium heat",
    "Add the sliced almonds and cook, stirring frequently, until lightly toasted",
    "Sprinkle the toasted almonds over the bread slices",
    "Garnish with chopped cilantro, if desired",
    "Serve immediately and enjoy"
  ],
