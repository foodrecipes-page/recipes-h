      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "red pepper flakes",
      "amount": "1/4 teaspoon"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large skillet over medium heat.",
    "Add the garlic and cook for 1 minute until fragrant.",
    "Add the mushrooms and cook for 5 minutes until they release their liquid and start to brown.",
    "Add the thyme, smoked paprika, salt, black pepper, and red pepper flakes, and cook for 1 minute.",
    "Stir in the lemon juice and cook for an additional 2 minutes.",
    "Taste and adjust the seasoning as needed.",
    "Transfer the mushroom mixture to a stone bowl dolsot.",
    "Serve immediately, garnished with additional thyme if desired."
  ],
