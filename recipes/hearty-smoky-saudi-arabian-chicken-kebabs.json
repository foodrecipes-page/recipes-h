      "name": "boneless chicken breast",
      "amount": "1 pound",
      "notes": "cut into 1 inch pieces"
    },
    {
      "name": "smoky paprika",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "bell pepper",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "carrot",
      "amount": "1 medium",
      "notes": "peeled and chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Preheat grill to 400 degrees Fahrenheit.",
    "In a large bowl, whisk together smoky paprika, salt, and black pepper.",
    "Add the chopped onion, bell pepper, and carrot to the bowl and stir to combine.",
    "Add the chicken to the bowl and stir to coat with the spice mixture.",
    "Thread the chicken and vegetables onto skewers.",
    "Brush the skewers with olive oil.",
    "Grill the skewers for 10-12 minutes, turning occasionally.",
    "Serve hot, garnished with minced garlic."
  ],
