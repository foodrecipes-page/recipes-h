      "name": "broccoli",
      "amount": "3 cups",
      "notes": "fresh"
    },
    {
      "name": "bonito flakes",
      "amount": "2 tablespoons",
      "notes": "dried and shaved"
    },
    {
      "name": "coconut oil",
      "amount": "1/4 cup"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "curry powder",
      "amount": "2 tablespoons"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Heat the coconut oil in a large pan over medium heat.",
    "Add the chopped onion and cook until it is translucent.",
    "Add the minced garlic and cook for an additional minute.",
    "Add the broccoli and cook until it is tender, about 5 minutes.",
    "Add the bonito flakes, curry powder, salt, and black pepper, and stir to combine.",
    "Reduce heat to low and simmer the curry for 10 minutes, stirring occasionally.",
    "Serve the curry hot, garnished with additional bonito flakes if desired.",
    "Refrigerate or freeze any leftovers for later use."
  ],
