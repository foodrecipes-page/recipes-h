{
  "title": "Hearty Dense Jamaican Broccoli Curry",
  "description": "A dense and flavorful Jamaican curry featuring broccoli and bonito flakes, perfect for a weeknight dinner, and sugar-free-friendly.",
  "cuisine": "Jamaican",
  "diet": [
    "sugar-free",
    "gluten-free"
  ],
