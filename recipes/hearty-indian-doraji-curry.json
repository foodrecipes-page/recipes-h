      "amount": "1/2 teaspoon"
    },
    {
      "name": "red wine",
      "amount": "1/4 cup"
    }
  ],
  "instructions": [
    "Heat oil in a large pan over medium heat.",
    "Add onion and cook until softened, about 5 minutes.",
    "Add garlic and ginger and cook for another minute.",
    "Add curry powder and cook for 1 minute, stirring constantly.",
    "Add doraji and cook for 5 minutes, stirring occasionally.",
    "Add coconut milk, salt, and black pepper, and stir to combine.",
    "Reduce heat to low and simmer for 10 minutes.",
    "Add red wine and stir to combine.",
    "Continue to simmer for another 5 minutes."
  ],
