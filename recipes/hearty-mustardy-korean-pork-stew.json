      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "sesame oil",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Heat the sesame oil in a large Dutch oven over medium heat.",
    "Add the pork and cook until browned on all sides, about 5 minutes.",
    "Add the garlic and ginger and cook for 1 minute.",
    "Add the Gochujang, brown mustard, and soy sauce, and stir to combine.",
    "Add the apple cider and bring to a boil.",
    "Reduce the heat to low and simmer, covered, for 2 hours.",
    "Season with salt and pepper to taste.",
    "Serve hot, garnished with chopped green onions and toasted sesame seeds.",
    "Cook pork to an internal temperature of 63°C / 145°F and let it rest for 3 minutes before serving."
  ],
