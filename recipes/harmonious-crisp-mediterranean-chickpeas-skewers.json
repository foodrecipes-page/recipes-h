{
  "title": "Harmonious Crisp Mediterranean Chickpeas Skewers",
  "description": "A sour and crisp Mediterranean dish perfect for a date night, featuring chervil and pickle, and is plant-based friendly.",
  "cuisine": "Mediterranean",
  "diet": [
    "vegetarian",
    "vegan",
    "gluten-free"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "chickpeas",
      "amount": "1 1/2 cups",
      "notes": "drained and rinsed"
    },
    {
      "name": "chervil",
      "amount": "1/4 cup",
      "notes": "freshly chopped"
    },
    {
      "name": "pickle juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "garlic",
      "amount": "2 cloves",
      "notes": "minced"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/4 teaspoon"
    },
    {
      "name": "pita bread",
      "amount": "1 cup",
      "notes": "cut into 1-inch cubes"
    },
    {
      "name": "dates",
      "amount": "1/2 cup",
      "notes": "pitted"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit.",
    "In a large bowl, whisk together lemon juice, pickle juice, olive oil, garlic, salt, and black pepper.",
    "Add the chickpeas to the bowl and toss to coat with the marinade.",
    "Thread the marinated chickpeas, pita bread cubes, and dates onto skewers.",
    "Sprinkle the chopped chervil over the skewers.",
    "Place the skewers on a baking sheet lined with parchment paper.",
    "Bake for 20 minutes, or until the chickpeas are crispy and the pita bread is toasted.",
    "Serve hot and enjoy."
  ],
