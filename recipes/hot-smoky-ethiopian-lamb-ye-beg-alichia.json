  "ingredients": [
    {
      "name": "lamb shoulder",
      "amount": "1 1/2 pounds",
      "notes": "cut into 1 inch pieces"
    },
    {
      "name": "hot smoked paprika",
      "amount": "2 tablespoons"
    },
    {
      "name": "berbere spice",
      "amount": "1 tablespoon"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "vegetable oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "fresh cilantro",
      "amount": "1/4 cup",
      "notes": "chopped"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "chicken broth",
      "amount": "1 cup"
    }
  ],
  "instructions": [
    "Preheat the ttukbaegi earthenware pot over medium heat.",
    "Add the vegetable oil and swirl it around to coat the bottom of the pot.",
    "Add the lamb pieces and cook until browned on all sides, about 5 minutes.",
    "Add the hot smoked paprika, berbere spice, salt, and black pepper, and stir to combine.",
    "Add the chicken broth, bring to a boil, then reduce the heat to low and simmer, covered, for 1 1/2 hours.",
    "Stir in the lemon juice and chopped cilantro.",
    "Serve the lamb hot, garnished with additional cilantro if desired.",
    "Cook poultry to an internal temperature of 74°C / 165°F before serving."
  ],
