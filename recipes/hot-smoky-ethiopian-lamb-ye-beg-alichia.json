{
  "title": "Hot Smoky Ethiopian Lamb Ye Beg Alichia",
  "description": "A sweet and juicy Ethiopian dish featuring hot smoked paprika, cooked in a traditional ttukbaegi earthenware pot, perfect for special occasions.",
  "cuisine": "Ethiopian",
  "diet": [
    "gluten-free",
