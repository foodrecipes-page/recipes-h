  "ingredients": [
    {
      "name": "lamb shoulder",
      "amount": "1 pound",
      "notes": "cut into 1 inch cubes"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "lemon zest",
      "amount": "2 tablespoons"
    },
    {
      "name": "shio-cure",
      "amount": "1 teaspoon"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "fresh rosemary",
      "amount": "2 sprigs",
      "notes": "chopped"
    },
    {
      "name": "fresh thyme",
      "amount": "1 sprig",
      "notes": "chopped"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the grill to medium-high heat, about 400 degrees Fahrenheit.",
    "In a large bowl, whisk together olive oil, garlic, lemon zest, shio-cure, salt, and black pepper.",
    "Add the lamb cubes to the bowl and toss to coat with the marinade.",
    "Thread the lamb cubes onto skewers, leaving a small space between each piece.",
    "Brush the grill with oil to prevent sticking and grill the skewers for 10-12 minutes, turning occasionally.",
    "Sprinkle the chopped rosemary and thyme over the skewers during the last 2 minutes of grilling.",
    "Let the skewers rest for 5 minutes before serving.",
    "Serve hot and enjoy."
  ],
