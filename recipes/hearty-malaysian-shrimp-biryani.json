      "amount": "1 teaspoon"
    },
    {
      "name": "ghee",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Heat ghee in a large saucepan over medium heat",
    "Add onion and cook until softened, about 5 minutes",
    "Add garlic and ginger and cook for 1 minute",
    "Add cumin powder, coriander powder, and turmeric powder and cook for 1 minute",
    "Add shrimp and cook until pink, about 2-3 minutes per side",
    "Add basmati rice and stir to combine with spices and shrimp",
    "Add 4 cups of water and bring to a boil",
    "Reduce heat to low, cover, and simmer for 15 minutes",
    "Turn off heat and let sit for 5 minutes before serving"
  ],
