      "amount": "1 tsp"
    },
    {
      "name": "sesame oil",
      "amount": "1 tsp"
    },
    {
      "name": "scallions",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Heat the vegetable oil in a large ttukbaegi earthenware pot over medium heat.",
    "Add the minced garlic and grated ginger and stir-fry until fragrant.",
    "Add the lo-mein noodles and stir-fry for 2 minutes.",
    "Add the soy sauce, oyster sauce, and sugar, and stir-fry for 1 minute.",
    "Add the sesame oil and stir-fry for 1 minute.",
    "Transfer the noodles to a talavera plate.",
    "Garnish with chopped scallions.",
    "Serve immediately.",
    "Cook the noodles according to the package instructions if using dried noodles.",
    "Use tortillas as a substitute for lo-mein noodles if preferred."
  ],
