      "name": "beef brisket",
      "amount": "2 pounds",
      "notes": "cut into 2 inch pieces"
    },
    {
      "name": "beef stock",
      "amount": "4 cups",
      "notes": "hot"
    },
    {
      "name": "coconut oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "bell pepper",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "tomato paste",
      "amount": "2 tablespoons"
    },
    {
      "name": "lacquer glaze",
      "amount": "1/4 cup"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Heat the coconut oil in a large Dutch oven over medium high heat.",
    "Add the beef to the pot and cook until browned on all sides, about 5 minutes.",
    "Add the onion, garlic, and bell pepper to the pot and cook until the vegetables are tender, about 5 minutes.",
    "Add the beef stock, tomato paste, lacquer glaze, salt, and pepper to the pot and stir to combine.",
    "Bring the mixture to a boil, then reduce the heat to low and simmer, covered, for 2 1/2 hours.",
    "Remove the pot from the heat and let it cool slightly.",
    "Serve the stew hot, garnished with fresh herbs if desired."
  ],
