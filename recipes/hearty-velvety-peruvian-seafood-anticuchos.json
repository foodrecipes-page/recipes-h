    },
    {
      "name": "ginger",
      "amount": "1 tablespoon",
      "notes": "grated"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Heat the seafood stock in a large pot over medium heat until it starts to simmer.",
    "Add the garlic and ginger to the pot and cook for 1 minute, stirring constantly.",
    "Add the shrimp, scallops, and mussels to the pot, and cook for 2-3 minutes, or until they start to turn opaque.",
    "Stir in the coconut milk and bring the mixture to a simmer.",
    "Reduce the heat to low and let the mixture cook for 5 minutes, or until the seafood is cooked through and the sauce has thickened.",
    "Stir in the lime juice, salt, and black pepper.",
    "Taste and adjust the seasoning as needed.",
    "Serve the anticuchos in a stone bowl, garnished with chopped fresh cilantro if desired."
  ],
