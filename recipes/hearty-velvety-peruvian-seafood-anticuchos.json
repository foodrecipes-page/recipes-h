      "name": "scallops",
      "amount": "1/2 pound",
      "notes": "rinsed and patted dry"
    },
    {
      "name": "mussels",
      "amount": "1/2 pound",
      "notes": "scrubbed and debearded"
    },
    {
      "name": "seafood stock",
      "amount": "2 cups"
    },
    {
      "name": "coconut milk",
      "amount": "1 cup"
    },
