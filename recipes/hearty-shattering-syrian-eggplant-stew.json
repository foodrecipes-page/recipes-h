      "name": "eggplant",
      "amount": "2 medium",
      "notes": "cut into 1 inch cubes"
    },
    {
      "name": "ferment-jang",
      "amount": "1/4 cup",
      "notes": "Korean fermented soybean paste"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 large",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "tomato paste",
      "amount": "2 tablespoons"
    },
    {
      "name": "vegetable broth",
      "amount": "4 cups"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large pot over medium heat.",
    "Add the chopped onion and cook until it is translucent, about 5 minutes.",
    "Add the minced garlic and cook for an additional 1 minute.",
    "Add the cubed eggplant and cook until it starts to soften, about 5 minutes.",
    "Add the ferment-jang, tomato paste, salt, and black pepper, and stir to combine.",
    "Add the vegetable broth and bring the mixture to a boil.",
    "Reduce the heat to low and simmer, covered, for 20 minutes.",
    "Stir in the chopped parsley and serve hot."
  ],
