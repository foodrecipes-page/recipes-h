  "instructions": [
    "preheat oven to 300\u000232f (150\u000232c) with binchotan charcoal",
    "mix perilla-leaf-kkaennip, cassava flour, and seaweed in a large bowl",
    "add coconut oil, apple cider vinegar, and black sesame seeds, mixing until combined",
    "transfer the mixture to a ceramic vessel and shape into a round",
    "drizzle water over the top and sprinkle with sea salt",
    "cover the vessel with a lid or foil and bake for 2 hours",
    "remove the lid or foil and bake for an additional 30 minutes",
    "let the bake cool completely before serving",
    "slice into wedges and serve"
  ],
