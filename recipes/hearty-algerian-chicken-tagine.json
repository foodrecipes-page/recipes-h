  "instructions": [
    "Heat the olive oil in a large Dutch oven over medium heat",
    "Add the sliced almonds and cook until lightly toasted, about 2 minutes",
    "Add the chopped onion and cook until softened, about 5 minutes",
    "Add the minced garlic and grated ginger and cook for 1 minute",
    "Add the chicken thighs and cook until browned on all sides, about 5 minutes",
    "Add the cumin, coriander, and cayenne pepper and cook for 1 minute",
    "Add the chicken broth and bring to a boil",
    "Reduce the heat to low and simmer, covered, for 30 minutes",
    "Season with salt to taste",
    "Serve hot, garnished with chopped fresh parsley"
  ],
