      "notes": "homemade or store-bought"
    },
    {
      "name": "ferment-kimchi",
      "amount": "1 cup",
      "notes": "store-bought or homemade"
    },
    {
      "name": "shrimp",
      "amount": "1 pound",
      "notes": "peeled and deveined"
    },
    {
      "name": "cod fillets",
      "amount": "1 pound",
      "notes": "cut into bite-sized pieces"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 tablespoon",
      "notes": "grated"
    },
    {
      "name": "cumin",
      "amount": "1 teaspoon",
      "notes": "ground"
    },
    {
      "name": "coriander",
      "amount": "1 teaspoon",
      "notes": "ground"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons",
      "notes": "for sauteing"
    }
  ],
  "instructions": [
    "Heat the olive oil in a large pot over medium heat.",
    "Add the chopped onion and saute until translucent, about 5 minutes.",
    "Add the minced garlic and grated ginger and saute for another minute.",
    "Add the cumin and coriander and stir to combine.",
    "Add the seafood stock, ferment-kimchi, shrimp, and cod fillets to the pot.",
    "Bring the mixture to a boil, then reduce the heat to low and simmer for 10 minutes.",
    "Use an immersion blender to puree the bisque until smooth.",
    "Season the bisque with salt and pepper to taste.",
    "Serve the bisque hot, garnished with chopped fresh herbs if desired."
  ],
