{
  "title": "Honeyed Velvet Argentinian Bananas Roast",
  "description": "A resinous, velvety dessert that marries sweet bananas with honey and cinnamon, roasted on a cedar plank for a smoky finish.",
  "cuisine": "Argentinian",
  "diet": [
    "vegetarian",
    "vegan-friendly",
    "egg-free"
  ],
  "meal": "dessert",
  "ingredients": [
    {
      "name": "banana",
      "amount": "4 medium",
      "notes": "peeled and sliced lengthwise"
    },
    {
      "name": "honey",
      "amount": "2 tbsp",
      "notes": "drizzled"
    },
    {
      "name": "olive oil",
      "amount": "1 tbsp",
      "notes": "sprinkled"
    },
    {
      "name": "cinnamon powder",
      "amount": "1 tsp",
      "notes": "sprinkled"
    },
    {
      "name": "sea salt",
      "amount": "1/4 tsp",
      "notes": "sprinkled"
    },
    {
      "name": "lime zest",
      "amount": "1 tsp",
      "notes": "for garnish"
    },
    {
      "name": "cedar plank",
      "amount": "1 medium",
      "notes": "pre-soaked in water for 30 min"
    }
  ],
  "instructions": [
    "Preheat tandoor oven to 200°C and place cedar plank inside to heat.",
    "Arrange banana slices on a baking sheet while the plank heats.",
    "Drizzle olive oil over banana slices and sprinkle with cinnamon and sea salt.",
    "Roast bananas on the cedar plank in the tandoor for 12 minutes until caramelized and slightly charred.",
    "Remove the plank from the tandoor and drizzle honey evenly over the hot bananas.",
    "Let the bananas sit for 2 minutes so the honey sinks into the caramelized surface.",
    "Garnish with lime zest before serving."
  ],
