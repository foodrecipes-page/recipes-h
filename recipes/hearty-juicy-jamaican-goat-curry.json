  "instructions": [
    "Preheat the oven to 300 degrees Fahrenheit",
    "Season the goat meat with salt and curry powder",
    "Heat oil in a large skillet and sear the goat meat until browned",
    "Add the onion and garlic to the skillet and cook until the onion is translucent",
    "Add the currants and coconut milk to the skillet and stir to combine",
    "Transfer the mixture to a baking dish and cover with papillote paper",
    "Bake for 2 hours or until the meat is tender",
    "Remove the papillote paper and serve hot"
  ],
