{
  "title": "Hearty Shaggy Croatian Lamb Kebabs",
  "description": "A pungent and flavorful Croatian dish featuring lamb, sultanas, and shio-cure, quickly grilled to perfection on a robata-grill.",
  "cuisine": "Croatian",
  "diet": [
    "gluten-free",
    "dairy-free"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "lamb shoulder",
      "amount": "1 pound",
      "notes": "cut into 1-inch cubes"
    },
    {
      "name": "sultanas",
      "amount": "1/2 cup"
    },
    {
      "name": "shio-cure",
      "amount": "2 tablespoons"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "paprika",
      "amount": "1 teaspoon"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "fresh parsley",
      "amount": "1/4 cup",
      "notes": "chopped"
    }
  ],
  "instructions": [
    "Preheat the robata-grill to medium-high heat.",
    "In a large bowl, whisk together olive oil, garlic, paprika, salt, and black pepper.",
    "Add the lamb cubes to the bowl and toss to coat with the marinade.",
    "Thread the lamb cubes onto skewers, leaving a small space between each piece.",
    "Sprinkle the sultanas and shio-cure over the lamb cubes.",
    "Grill the kebabs for 8-10 minutes, turning occasionally, until the lamb is cooked to an internal temperature of 145 degrees.",
    "Garnish with chopped fresh parsley and serve immediately."
  ],
