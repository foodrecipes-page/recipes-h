  "ingredients": [
    {
      "name": "sauerkraut",
      "amount": "1 cup",
      "notes": "drained and rinsed"
    },
    {
      "name": "ground beef",
      "amount": "1/2 pound",
      "notes": "cooked and drained"
    },
    {
      "name": "onion",
      "amount": "1/2 cup",
      "notes": "chopped"
    },
    {
      "name": "empanada dough",
      "amount": "1 package",
      "notes": "thawed"
    },
    {
      "name": "egg",
      "amount": "1",
      "notes": "beaten"
    },
    {
      "name": "water",
      "amount": "1/4 cup",
      "notes": "cold"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon",
      "notes": "to taste"
    },
    {
      "name": "pepper",
      "amount": "1/4 teaspoon",
      "notes": "to taste"
    }
  ],
  "instructions": [
    "Preheat oven to 375 degrees.",
    "In a large bowl, combine sauerkraut, ground beef, and onion.",
    "Roll out empanada dough to a thickness of 1/8 inch.",
    "Use a cookie cutter or a glass to cut out circles of dough.",
    "Place a tablespoon of the sauerkraut mixture in the center of each dough circle.",
    "Brush the edges of the dough with the beaten egg.",
    "Fold the dough in half to form a half-moon shape and press the edges together to seal.",
    "Brush the tops of the empanadas with the cold water.",
    "Sprinkle the tops with salt and pepper to taste.",
    "Place the empanadas in a terracotta dish and bake for 20 minutes."
  ],
