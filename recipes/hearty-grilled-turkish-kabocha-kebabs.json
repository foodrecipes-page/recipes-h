  "ingredients": [
    {
      "name": "1 kabocha squash (about 2 lbs)",
      "amount": "1",
      "notes": "cut into 1-inch cubes"
    },
    {
      "name": "1/4 cup olive oil",
      "amount": "1/4 cup",
      "notes": "for brushing kabocha"
    },
    {
      "name": "2 cloves garlic, minced",
      "amount": "2",
      "notes": "for flavor"
    },
    {
      "name": "1 tsp ground cumin",
      "amount": "1 tsp",
      "notes": "for added spice"
    },
    {
      "name": "1 tsp smoked paprika",
      "amount": "1 tsp",
      "notes": "optional for a smoky flavor"
    },
    {
      "name": "Salt and pepper to taste",
      "amount": "to taste",
      "notes": "for seasoning"
    },
    {
      "name": "8 wooden skewers, soaked in water",
      "amount": "8",
      "notes": "for grilling"
    }
  ],
  "instructions": [
    "Preheat grill to medium-high heat",
    "In a large bowl, combine kabocha, olive oil, garlic, cumin, smoked paprika (if using), salt, and pepper; mix well",
    "Thread kabocha mixture onto skewers, leaving a little space between each piece",
    "Grill kabocha kebabs for 20-25 minutes, turning occasionally, until tender and lightly charred",
    "Serve hot, garnished with fresh parsley or cilantro (optional)"
  ],
