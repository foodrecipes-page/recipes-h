{
  "title": "Hearty Grilled Turkish Kabocha Kebabs",
  "description": "A comforting Turkish dish featuring kabocha, perfect for the grill, and gluten-free-friendly",
  "cuisine": "Turkish",
  "diet": [
    "gluten-free",
    "Vegetarian"
  ],
