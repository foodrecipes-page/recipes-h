      "amount": "1 cup",
      "notes": null
    },
    {
      "name": "4 tablespoons butter",
      "amount": "4 tablespoons",
      "notes": null
    },
    {
      "name": "4 mushrooms",
      "amount": "4",
      "notes": "Button or portobello"
    }
