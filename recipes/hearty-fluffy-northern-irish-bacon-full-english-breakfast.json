      "name": "6 slices thick-cut Irish bacon",
      "amount": "1",
      "notes": null
    },
    {
      "name": "6 eggs",
      "amount": "1 dozen",
      "notes": "Large eggs recommended"
    },
    {
      "name": "1/2 cup mixed peel",
      "amount": "1/2 cup",
      "notes": "Dried mixed peel can be used"
    },
    {
      "name": "1 cup all-purpose flour",
      "amount": "1 cup",
      "notes": null
    },
    {
      "name": "2 teaspoons salt",
      "amount": "2 teaspoons",
      "notes": null
    },
    {
