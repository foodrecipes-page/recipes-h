{
  "title": "Hearty Hot Irish Beef Stew",
  "description": "A resinous and chewy Irish dish featuring chilli powder and ferment-kimchi, perfect for a low-sodium diet",
  "cuisine": "Irish",
  "diet": [
    "low-sodium"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "beef stew meat",
      "amount": "1 pound",
      "notes": "cut into 1-inch pieces"
    },
    {
      "name": "chilli powder",
      "amount": "2 tablespoons"
    },
    {
      "name": "ferment-kimchi",
      "amount": "1 cup",
      "notes": "chopped"
    },
    {
      "name": "onions",
      "amount": "2 medium",
      "notes": "chopped"
    },
    {
      "name": "carrots",
      "amount": "4 medium",
      "notes": "peeled and chopped"
    },
    {
      "name": "potatoes",
      "amount": "2 large",
      "notes": "peeled and chopped"
    },
    {
      "name": "beef broth",
      "amount": "4 cups",
      "notes": "low-sodium"
    },
    {
      "name": "tomato paste",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Heat oil in a large Dutch oven over medium-high heat",
    "Add the beef and cook until browned on all sides",
    "Add the chilli powder and cook for 1 minute",
    "Add the onions, carrots, and potatoes, and cook until the vegetables are tender",
    "Add the ferment-kimchi, beef broth, and tomato paste, and stir to combine",
    "Bring the stew to a boil, then reduce the heat to low and simmer for 1 1/2 hours",
    "Season the stew with salt and pepper to taste",
    "Serve the stew hot, garnished with chopped fresh herbs if desired"
  ],
