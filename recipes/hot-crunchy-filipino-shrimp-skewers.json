{
  "title": "Hot Crunchy Filipino Shrimp Skewers",
  "description": "A funky and crunchy Filipino dish perfect for a date night, featuring garlic powder and yuzu-cure, and is dairy-free friendly. This dish is a unique and delicious twist on traditional Filipino cuisine.",
  "cuisine": "Filipino",
  "diet": [],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "large shrimp",
      "amount": "1 pound",
      "notes": "peeled and deveined"
    },
    {
      "name": "garlic powder",
      "amount": "2 tablespoons"
    },
    {
      "name": "yuzu juice",
      "amount": "1/4 cup"
    },
    {
      "name": "coconut milk",
      "amount": "1/4 cup"
    },
    {
      "name": "rice vinegar",
      "amount": "2 tablespoons"
    },
    {
      "name": "sesame oil",
      "amount": "1 tablespoon"
    },
    {
      "name": "panko breadcrumbs",
      "amount": "1 cup"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit.",
    "In a large bowl, whisk together garlic powder, yuzu juice, coconut milk, rice vinegar, sesame oil, salt, and black pepper.",
    "Add the shrimp to the bowl and toss to coat with the marinade.",
    "Let the shrimp marinate for at least 30 minutes.",
    "Thread the marinated shrimp onto skewers.",
    "Dip each skewer into the panko breadcrumbs to coat.",
    "Place the skewers on a baking sheet lined with parchment paper.",
    "Bake the skewers for 12 minutes or until pink and cooked through.",
    "Serve the skewers hot and enjoy."
  ],
