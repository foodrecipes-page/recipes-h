{
  "title": "Hearty Crunchy Jamaican Cauliflower Roast",
  "description": "A garlicky, midnight-craving Jamaican dish featuring black olives and kombu cold extract, roasted to crunchy perfection on a cedar plank.",
  "cuisine": "Jamaican",
  "diet": [
    "low-glycemic"
  ],
