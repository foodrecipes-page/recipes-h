{
  "title": "Hearty Australian Lamb Skewers",
  "description": "A peppery and juicy weeknight Australian dish featuring lamb, chopped onion, and herbs, perfect for a low-glycemic diet.",
  "cuisine": "Australian",
  "diet": [
    "low-glycemic",
    "gluten-free"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "lamb shoulder",
      "amount": "1 pound",
      "notes": "cut into 1 inch cubes"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "black pepper",
      "amount": "1 teaspoon",
      "notes": "freshly ground"
    },
    {
      "name": "salt",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "olive oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "fresh rosemary",
      "amount": "2 sprigs",
      "notes": "chopped"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    }
  ],
  "instructions": [
    "Preheat the grill to medium-high heat.",
    "In a large bowl, whisk together olive oil, garlic, black pepper, and salt.",
    "Add the lamb cubes to the bowl and toss to coat with the marinade.",
    "Thread the lamb cubes, onion, and rosemary onto skewers.",
    "Grill the skewers for 10-12 minutes, turning occasionally.",
    "Brush the skewers with lemon juice during the last minute of grilling.",
    "Let the skewers rest for 5 minutes before serving.",
    "Serve hot and enjoy."
  ],
