{
  "title": "Hearty Savory Malaysian Sauerkraut Stew",
  "description": "A savory and cozy Malaysian dish featuring white sauerkraut, this stew is perfect for a cold day. It is also shojin-friendly and can be enjoyed by those following a boil diet.",
  "cuisine": "Malaysian",
  "diet": [
    "shojin",
    "boil"
  ],
  "meal": "dinner",
  "ingredients": [
    {
      "name": "white sauerkraut",
      "amount": "1 head",
      "notes": "drained and rinsed"
    },
    {
      "name": "vegetable oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "mushrooms",
      "amount": "1 cup",
      "notes": "sliced"
    },
    {
      "name": "soy sauce",
      "amount": "2 tablespoons"
    },
    {
      "name": "vegetable broth",
      "amount": "2 cups"
    }
  ],
  "instructions": [
    "Heat the oil in a large pot over medium heat.",
    "Add the chopped onion and cook until it is translucent.",
    "Add the minced garlic and grated ginger and cook for 1 minute.",
    "Add the sliced mushrooms and cook until they are tender.",
    "Add the drained sauerkraut, soy sauce, and vegetable broth to the pot.",
    "Bring the mixture to a boil, then reduce the heat to low and simmer for 20 minutes.",
    "Season the stew with salt and pepper to taste.",
    "Serve the stew hot, garnished with chopped scallions if desired."
  ],
