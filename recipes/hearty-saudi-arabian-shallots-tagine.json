      "amount": "1/4 teaspoon"
    },
    {
      "name": "chopped fresh parsley",
      "amount": "1/4 cup"
    },
    {
      "name": "chopped fresh cilantro",
      "amount": "1/4 cup"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "water",
      "amount": "1 cup"
    }
  ],
  "instructions": [
    "Heat the olive oil in the bottom of a clay or ceramic tagine or talavera plate over medium heat.",
    "Add the chopped shallots and cook until they are softened and lightly browned.",
    "Stir in the ground cumin, ground coriander, cayenne pepper, salt, and black pepper.",
    "Cook for 1 minute, until the spices are fragrant.",
    "Add the chopped parsley and cilantro and stir to combine.",
    "Pour in the lemon juice and water, and bring the mixture to a simmer.",
    "Reduce the heat to low and cook, covered, until the shallots are very tender and the sauce has thickened.",
    "Serve the tagine hot, garnished with additional parsley and cilantro if desired."
  ],
