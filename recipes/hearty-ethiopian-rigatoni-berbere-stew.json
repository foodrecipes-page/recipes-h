  "instructions": [
    "Preheat the oven to 400 degrees Fahrenheit.",
    "Cook the rigatoni according to package instructions and set aside.",
    "In a large pot, heat the olive oil over medium heat.",
    "Add the onion and garlic and cook until the onion is translucent.",
    "Add the berbere spice and cook for 1 minute.",
    "Add the carrots and potatoes and cook for 5 minutes.",
    "Add the tomato paste and cook for 1 minute.",
    "Add the vegetable broth and bring to a boil.",
    "Reduce the heat to low and simmer for 20 minutes.",
    "Add the cooked rigatoni to the pot and stir to combine.",
    "Season with salt and black pepper to taste."
  ],
