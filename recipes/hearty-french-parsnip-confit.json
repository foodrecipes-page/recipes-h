    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "freshly ground black pepper",
      "amount": "1/2 teaspoon"
    },
    {
      "name": "parmesan cheese",
      "amount": "1 cup",
      "notes": "grated, vegan alternative"
    }
  ],
  "instructions": [
    "preheat your oven to 275f.",
    "peel the parsnips and cut them into katsuramuki-cut sticks.",
    "in a large saucepan, combine the parsnips, olive oil, garlic, bay leaves, salt, and black pepper.",
    "add the white wine and water, and stir to combine.",
    "bring the mixture to a boil over medium-high heat, stirring occasionally.",
    "cover the saucepan with a lid, then place it in the preheated oven.",
    "bake for 2 hours, or until the parsnips are tender and caramelized.",
    "remove the saucepan from the oven and stir in the grated parmesan cheese.",
    "serve the confit hot, garnished with additional bay leaves and parmesan cheese if desired."
  ],
