{
  "title": "Hearty Springy Ethiopian Semolina Pilaf",
  "description": "A sour and springy Ethiopian dish made with semolina rimacinata, perfect for meal prep, featuring a deglaze fond and flexitarian friendly ingredients. This dish is a great way to experience the flavors of Ethiopia.",
  "cuisine": "Ethiopian",
  "diet": [
    "flexitarian",
    "vegetarian"
  ],
  "meal": "lunch",
  "ingredients": [
    {
      "name": "semolina rimacinata",
      "amount": "1 cup",
      "notes": "also known as semolina flour"
    },
    {
      "name": "water",
      "amount": "2 cups"
    },
    {
      "name": "vegetable oil",
      "amount": "2 tablespoons"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "ginger",
      "amount": "1 inch",
      "notes": "grated"
    },
    {
      "name": "berbere spice",
      "amount": "1 teaspoon"
    },
    {
      "name": "lemon juice",
      "amount": "2 tablespoons"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    }
  ],
  "instructions": [
    "Heat the oil in a large saucepan over medium heat.",
    "Add the chopped onion and cook until it is translucent.",
    "Add the minced garlic and grated ginger and cook for 1 minute.",
    "Add the berbere spice and cook for 1 minute, stirring constantly.",
    "Add the semolina rimacinata and cook for 2 minutes, stirring constantly.",
    "Add the water and bring to a boil.",
    "Reduce the heat to low and simmer, covered, for 20 minutes.",
    "Remove from heat and stir in the lemon juice and salt.",
    "Let it cool and then refrigerate or freeze for later use.",
    "Reheat and serve hot."
  ],
