{
  "title": "Hearty Kenyan Cornmeal Casserole",
  "description": "A lazy Sunday Kenyan dish featuring white masarepa in a copper mug, perfect for a winey and shaggy day, this low-calorie-friendly casserole is en-croute and delicious.",
  "cuisine": "Kenyan",
  "diet": [
    "low-calorie",
    "gluten-free"
  ],
  "meal": "lunch",
  "ingredients": [
    {
      "name": "white masarepa",
      "amount": "2 cups",
      "notes": "also known as cornmeal"
    },
    {
      "name": "chicken breast",
      "amount": "1 pound",
      "notes": "boneless and skinless"
    },
    {
      "name": "onion",
      "amount": "1 medium",
      "notes": "chopped"
    },
    {
      "name": "garlic",
      "amount": "3 cloves",
      "notes": "minced"
    },
    {
      "name": "tomato",
      "amount": "2 medium",
      "notes": "diced"
    },
    {
      "name": "olive oil",
      "amount": "1/4 cup"
    },
    {
      "name": "salt",
      "amount": "1 teaspoon"
    },
    {
      "name": "black pepper",
      "amount": "1/2 teaspoon"
    }
  ],
  "instructions": [
    "Preheat the oven to 375 degrees Fahrenheit.",
    "In a large skillet, heat the olive oil over medium heat.",
    "Add the chopped onion and cook until softened, about 5 minutes.",
    "Add the minced garlic and cook for an additional minute.",
    "Add the diced tomato and cook for 2 minutes.",
    "In a large bowl, combine the cooked onion and tomato mixture, chicken breast, white masarepa, salt, and black pepper.",
    "Mix well to combine.",
    "Transfer the mixture to a copper mug.",
    "Bake for 30 minutes or until the casserole is golden brown and set."
  ],
