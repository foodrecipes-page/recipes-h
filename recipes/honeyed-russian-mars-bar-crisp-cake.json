      "notes": null
    },
    {
      "name": "confectioners' sugar",
      "amount": "1 cup",
      "notes": null
    }
  ],
  "instructions": [
    "preheat oven to 375f (190c).",
    "in a large molcajete, whisk together flour, baking powder, and salt.",
    "add melted butter and granulated sugar to molcajete and mix until a crumbly mixture forms.",
    "beat in eggs until mixture forms a cohesive dough.",
    "press dough evenly into the bottom of the molcajete.",
    "bake for 25 minutes.",
    "while cake is baking, melt mars bars in a saucepan over low heat.",
    "remove cake from oven and let cool for 5 minutes.",
    "drizzle melted mars bars over the top of the cake.",
    "sprinkle confectioners' sugar over the top of the cake.",
    "return cake to oven and broil for 1-2 minutes, or until golden brown."
  ],
